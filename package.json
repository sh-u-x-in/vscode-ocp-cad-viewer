{
  "name": "ocp-cad-viewer",
  "displayName": "OCP CAD Viewer",
  "description": "%extension.description%",
  "version": "4.2.0",
  "publisher": "bernhard-42",
  "icon": "resources/ocp-logo.png",
  "license": "Apache-2.0",
  "repository": "https://github.com/bernhard-42/vscode-ocp-cad-viewer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "ocpCadViewer.toggleWatch",
        "title": "%command.toggleWatch%"
      },
      {
        "command": "ocpCadViewer.ocpCadViewer",
        "title": "%command.openViewer%"
      },
      {
        "command": "ocpCadViewer.openViewer",
        "title": "%command.openViewerButton%",
        "icon": {
          "light": "resources/light/open.svg",
          "dark": "resources/dark/open.svg"
        }
      },
      {
        "command": "ocpCadViewer.openConsole",
        "title": "%command.openConsoleButton%",
        "icon": {
          "light": "resources/light/open.svg",
          "dark": "resources/dark/open.svg"
        }
      },
      {
        "command": "ocpCadViewer.installLibrary",
        "title": "%command.installLibrary%",
        "icon": {
          "light": "resources/light/install.svg",
          "dark": "resources/dark/install.svg"
        }
      },
      {
        "command": "ocpCadViewer.installPythonModule",
        "title": "%command.installPythonModule%",
        "icon": {
          "light": "resources/light/install.svg",
          "dark": "resources/dark/install.svg"
        }
      },
      {
        "command": "ocpCadViewer.installJupyterExtension",
        "title": "%command.installJupyterExtension%",
        "icon": {
          "light": "resources/light/install.svg",
          "dark": "resources/dark/install.svg"
        }
      },
      {
        "command": "ocpCadViewer.installVscodeSnippets",
        "title": "%command.installVscodeSnippets%"
      },
      {
        "command": "ocpCadViewer.downloadExamples",
        "title": "%command.downloadExamples%",
        "icon": {
          "light": "resources/light/install.svg",
          "dark": "resources/dark/install.svg"
        }
      },
      {
        "command": "ocpCadViewer.pasteSnippet",
        "title": "%command.pasteSnippet%",
        "icon": {
          "light": "resources/light/paste.svg",
          "dark": "resources/dark/paste.svg"
        }
      },
      {
        "command": "ocpCadViewer.refreshLibraries",
        "title": "%command.refreshLibraries%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "ocpCadViewer.preferences",
        "title": "%command.preferences%",
        "icon": {
          "light": "resources/light/settings.svg",
          "dark": "resources/dark/settings.svg"
        }
      },
      {
        "command": "ocpCadViewer.output",
        "title": "%command.output%",
        "icon": {
          "light": "resources/light/output.svg",
          "dark": "resources/dark/output.svg"
        }
      },
      {
        "command": "ocpCadViewer.quickstart",
        "title": "%command.quickstart%",
        "args": [
          {
            "name": "app",
            "type": "string",
            "description": "%command.quickstart.args.app%"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ocpCadHome",
          "title": "OCP CAD Viewer",
          "icon": "resources/ocp-icon.svg"
        }
      ]
    },
    "views": {
      "ocpCadHome": [
        {
          "id": "ocpCadStatus",
          "name": "%view.viewerManager%"
        },
        {
          "id": "ocpCadSetup",
          "name": "%view.libraryManager%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.selectPython%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.quickstarts%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.quickstartBuild123d%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.quickstartCadQuery%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.furtherLibraries%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.libraryManagerHint%"
      },
      {
        "view": "ocpCadStatus",
        "contents": "%viewsWelcome.openPreferences%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ocpCadViewer.refreshLibraries",
          "when": "view == ocpCadSetup",
          "group": "navigation@1"
        },
        {
          "command": "ocpCadViewer.preferences",
          "when": "view == ocpCadStatus",
          "group": "navigation@2"
        },
        {
          "command": "ocpCadViewer.output",
          "when": "view == ocpCadStatus",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ocpCadViewer.installLibrary",
          "when": "view == ocpCadSetup && viewItem == library",
          "group": "inline@0"
        },
        {
          "command": "ocpCadViewer.installJupyterExtension",
          "when": "view == ocpCadStatus && viewItem == jupyterExtMissing",
          "group": "inline@0"
        },
        {
          "command": "ocpCadViewer.downloadExamples",
          "when": "view == ocpCadSetup && viewItem == examples",
          "group": "inline@0"
        },
        {
          "command": "ocpCadViewer.pasteSnippet",
          "when": "view == ocpCadStatus && viewItem == library",
          "group": "inline@1"
        },
        {
          "command": "ocpCadViewer.pasteSnippet",
          "when": "view == ocpCadStatus && viewItem == status",
          "group": "inline@1"
        },
        {
          "command": "ocpCadViewer.pasteSnippet",
          "when": "view == ocpCadStatus && viewItem == open",
          "group": "inline@1"
        },
        {
          "command": "ocpCadViewer.openViewer",
          "when": "view == ocpCadStatus && viewItem == status",
          "group": "inline@0"
        },
        {
          "command": "ocpCadViewer.openConsole",
          "when": "view == ocpCadStatus && viewItem == console",
          "group": "inline@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ocpCadViewer.ocpCadViewer",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId=='python'"
      }
    ],
    "configuration": {
      "title": "OCP CAD Viewer",
      "properties": {
        "OcpCadViewer.view.tree_width": {
          "type": "integer",
          "default": 240,
          "description": "%config.view.tree_width%",
          "order": 0
        },
        "OcpCadViewer.view.glass": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.glass%",
          "order": 1
        },
        "OcpCadViewer.view.tools": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.tools%",
          "order": 2
        },
        "OcpCadViewer.view.new_tree_behavior": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.new_tree_behavior%",
          "order": 2
        },
        "OcpCadViewer.view.theme": {
          "enum": [
            "browser",
            "light",
            "dark"
          ],
          "default": "browser",
          "description": "%config.view.theme%",
          "order": 3
        },
        "OcpCadViewer.view.orbit_control": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.orbit_control%",
          "order": 4
        },
        "OcpCadViewer.view.up": {
          "type": "string",
          "enum": [
            "Z",
            "Y"
          ],
          "default": "Z",
          "description": "%config.view.up%",
          "order": 5
        },
        "OcpCadViewer.view.rotate_speed": {
          "type": "number",
          "default": 1,
          "description": "%config.view.rotate_speed%",
          "order": 6
        },
        "OcpCadViewer.view.zoom_speed": {
          "type": "number",
          "default": 1,
          "description": "%config.view.zoom_speed%",
          "order": 7
        },
        "OcpCadViewer.view.pan_speed": {
          "type": "number",
          "default": 1,
          "description": "%config.view.pan_speed%",
          "order": 8
        },
        "OcpCadViewer.view.axes": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.axes%",
          "order": 9
        },
        "OcpCadViewer.view.axes0": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.axes0%",
          "order": 10
        },
        "OcpCadViewer.view.black_edges": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.black_edges%",
          "order": 11
        },
        "OcpCadViewer.view.grid_XY": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.grid_XY%",
          "order": 12
        },
        "OcpCadViewer.view.grid_YZ": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.grid_YZ%",
          "order": 13
        },
        "OcpCadViewer.view.grid_XZ": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.grid_XZ%",
          "order": 14
        },
        "OcpCadViewer.view.center_grid": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.center_grid%",
          "order": 15
        },
        "OcpCadViewer.view.collapse": {
          "type": "string",
          "enum": [
            "none",
            "leaves",
            "all",
            "root"
          ],
          "default": "leaves",
          "description": "%config.view.collapse%",
          "order": 16
        },
        "OcpCadViewer.view.ortho": {
          "type": "boolean",
          "default": true,
          "description": "%config.view.ortho%",
          "order": 17
        },
        "OcpCadViewer.view.grid_font_size": {
          "type": "number",
          "default": 12,
          "description": "%config.view.grid_font_size%",
          "order": 19
        },
        "OcpCadViewer.view.ticks": {
          "type": "number",
          "default": 5,
          "description": "%config.view.ticks%",
          "order": 18
        },
        "OcpCadViewer.view.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "zh-CN",
          "description": "%config.view.language%",
          "order": 20
        },
        "OcpCadViewer.view.transparent": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.transparent%",
          "order": 30
        },
        "OcpCadViewer.view.default_opacity": {
          "type": "number",
          "default": 0.5,
          "description": "%config.view.default_opacity%",
          "order": 31
        },
        "OcpCadViewer.view.explode": {
          "type": "boolean",
          "default": false,
          "description": "%config.view.explode%",
          "order": 32
        },
        "OcpCadViewer.view.reset_camera": {
          "type": "string",
          "enum": [
            "RESET",
            "KEEP",
            "CENTER",
            "ISO",
            "TOP",
            "BOTTOM",
            "LEFT",
            "RIGHT",
            "FRONT",
            "BACK"
          ],
          "default": "KEEP",
          "description": "%config.view.reset_camera%",
          "order": 59
        },
        "OcpCadViewer.view.modifier_keys": {
          "type": "object",
          "default": {
            "macOS": {
              "shift": "shiftKey",
              "ctrl": "ctrlKey",
              "meta": "metaKey",
              "alt": "altKey"
            },
            "default": {
              "shift": "shiftKey",
              "ctrl": "ctrlKey",
              "meta": "altKey",
              "alt": "metaKey"
            }
          },
          "description": "%config.view.modifier_keys%",
          "order": 33
        },
        "OcpCadViewer.render.angular_tolerance": {
          "type": "number",
          "default": 0.2,
          "description": "%config.render.angular_tolerance%",
          "order": 34
        },
        "OcpCadViewer.render.deviation": {
          "type": "number",
          "default": 0.1,
          "description": "%config.render.deviation%",
          "order": 35
        },
        "OcpCadViewer.render.default_color": {
          "type": "string",
          "default": "#e8b024",
          "description": "%config.render.default_color%",
          "order": 36
        },
        "OcpCadViewer.render.default_edgecolor": {
          "type": "string",
          "default": "#707070",
          "description": "%config.render.default_edgecolor%",
          "order": 37
        },
        "OcpCadViewer.render.default_thickedgecolor": {
          "type": "string",
          "default": "MediumOrchid",
          "description": "%config.render.default_thickedgecolor%",
          "order": 38
        },
        "OcpCadViewer.render.default_facecolor": {
          "type": "string",
          "default": "Violet",
          "description": "%config.render.default_facecolor%",
          "order": 39
        },
        "OcpCadViewer.render.default_vertexcolor": {
          "type": "string",
          "default": "MediumOrchid",
          "description": "%config.render.default_vertexcolor%",
          "order": 40
        },
        "OcpCadViewer.render.ambient_intensity": {
          "type": "number",
          "default": 1,
          "description": "%config.render.ambient_intensity%",
          "order": 41
        },
        "OcpCadViewer.render.direct_intensity": {
          "type": "number",
          "default": 1.1,
          "description": "%config.render.direct_intensity%",
          "order": 42
        },
        "OcpCadViewer.render.metalness": {
          "type": "number",
          "default": 0.3,
          "description": "%config.render.metalness%",
          "order": 43
        },
        "OcpCadViewer.render.roughness": {
          "type": "number",
          "default": 0.65,
          "description": "%config.render.roughness%",
          "order": 44
        },
        "OcpCadViewer.render.python_enumeration": {
          "type": "boolean",
          "default": true,
          "description": "%config.render.python_enumeration%",
          "order": 45
        },
        "OcpCadViewer.advanced.watchCommands": {
          "type": "string",
          "default": "from ocp_vscode import show_all, get_port; show_all(locals(), port=get_port(), _visual_debug=True)",
          "description": "%config.advanced.watchCommands%",
          "order": 50
        },
        "OcpCadViewer.advanced.watchByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%config.advanced.watchByDefault%",
          "order": 51
        },
        "OcpCadViewer.advanced.autostart": {
          "type": "boolean",
          "default": true,
          "description": "%config.advanced.autostart%",
          "order": 52
        },
        "OcpCadViewer.advanced.autostartTriggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "from ocp_vscode import",
            "import ocp_vscode",
            "from ocp_viewer_core.viewer import",
            "import ocp_viewer_core.viewer"
          ],
          "description": "%config.advanced.autostartTriggers%",
          "order": 53
        },
        "OcpCadViewer.advanced.autohideTerminal": {
          "type": "boolean",
          "default": false,
          "description": "%config.advanced.autohideTerminal%",
          "order": 54
        },
        "OcpCadViewer.advanced.initialPort": {
          "type": "number",
          "default": 3939,
          "description": "%config.advanced.initialPort%",
          "order": 55
        },
        "OcpCadViewer.advanced.shellCommandPrefix": {
          "type": "string",
          "default": "",
          "description": "%config.advanced.shellCommandPrefix%",
          "order": 56
        },
        "OcpCadViewer.advanced.quickstartCommands": {
          "type": "object",
          "description": "%config.advanced.quickstartCommands%",
          "default": {
            "cadquery": [
              "{unset_conda} {pip-install}  ocp_vscode~={ocp_vscode_version} cadquery"
            ],
            "build123d": [
              "{pip-install}  ocp_vscode~={ocp_vscode_version} git+https://github.com/gumyr/build123d"
            ]
          },
          "order": 57
        },
        "OcpCadViewer.advanced.installCommands": {
          "type": "object",
          "description": "%config.advanced.installCommands%",
          "default": {
            "cadquery": [
              "{unset_conda} {pip-install} --upgrade cadquery"
            ],
            "build123d": [
              "{pip-install}  --upgrade git+https://github.com/gumyr/build123d"
            ],
            "cadquery_ocp": [
              "{pip-install}  --upgrade cadquery_ocp"
            ],
            "ocp_vscode": [
              "{pip-install}  --upgrade ocp_vscode~={ocp_vscode_version}"
            ],
            "ocp_viewer_core": [
              "{pip-install}  --upgrade ocp_viewer_core"
            ],
            "ocp_tessellate": [
              "{pip-install}  --upgrade ocp_tessellate"
            ],
            "ipykernel": [
              "{pip-install}  --upgrade ipykernel"
            ],
            "jupyter_console": [
              "{pip-install}  --upgrade jupyter_console"
            ]
          },
          "order": 58
        },
        "OcpCadViewer.advanced.codeSnippets": {
          "type": "object",
          "description": "%config.advanced.codeSnippets%",
          "default": {
            "cadquery": [
              "import cadquery as cq"
            ],
            "build123d": [
              "from build123d import *"
            ],
            "ocp_vscode": [
              "from ocp_vscode import *"
            ],
            "cadquery_ocp": [
              "import OCP"
            ],
            "jupyter": [
              "\n# %%\n"
            ]
          },
          "order": 59
        },
        "OcpCadViewer.advanced.exampleDownloads": {
          "type": "object",
          "description": "%config.advanced.exampleDownloads%",
          "default": {
            "cadquery": {
              "zip": "https://github.com/CadQuery/cadquery/archive/refs/heads/master.zip",
              "example_path": "cadquery-master/examples"
            },
            "build123d": {
              "zip": "https://github.com/gumyr/build123d/archive/refs/heads/dev.zip",
              "example_path": "build123d-dev/examples"
            }
          },
          "order": 60
        },
        "OcpCadViewer.snippets.dotVscodeSnippets": {
          "type": "object",
          "description": "%config.snippets.dotVscodeSnippets%",
          "default": {
            "build123d": {
              "BuildPart": {
                "scope": "python",
                "prefix": "bd_p",
                "body": [
                  "with {prefix}BuildPart() as ${1:partname}:",
                  "    $0"
                ]
              },
              "BuildSketch": {
                "scope": "python",
                "prefix": "bd_s",
                "body": [
                  "with {prefix}BuildSketch() as ${1:sketchname}:",
                  "    $0"
                ]
              },
              "BuildLine": {
                "scope": "python",
                "prefix": "bd_l",
                "body": [
                  "with {prefix}BuildLine() as ${1:linename}:",
                  "    $0"
                ]
              },
              "Part": {
                "scope": "python",
                "prefix": "bd_bp",
                "body": [
                  "with {prefix}BuildPart() as ${1:partname}:",
                  "    {prefix}${2:class}(${3:params}, align=({prefix}Align.CENTER, {prefix}Align.CENTER, {prefix}Align.CENTER))",
                  "    $0"
                ]
              },
              "Sketch": {
                "scope": "python",
                "prefix": "bd_bs",
                "body": [
                  "with {prefix}BuildSketch() as ${1:sketchname}:",
                  "    {prefix}${2:class}(${3:params}, align=({prefix}Align.CENTER, {prefix}Align.CENTER))",
                  "    $0"
                ]
              },
              "Line": {
                "scope": "python",
                "prefix": "bd_bl",
                "body": [
                  "with {prefix}BuildLine() as ${1:linename}:",
                  "    {prefix}${2:class}(${3:params})",
                  "    $0"
                ]
              },
              "LineChain": {
                "scope": "python",
                "prefix": "bd_lchain",
                "body": [
                  "with {prefix}BuildLine() as ${1:linename}:",
                  "    ${2:l1} = {prefix}Line((${3:start}), (${4:end}))",
                  "    ${5:l2} = {prefix}Line(${2:l1} @ 0, (${6:end}))",
                  "    ${7:l3} = {prefix}Line(${5:l2} @ 0, (${8:end}))",
                  "    $0"
                ]
              },
              "PartSketch": {
                "scope": "python",
                "prefix": "bd_pask",
                "body": [
                  "with {prefix}BuildPart() as ${1:partname}:",
                  "    with {prefix}BuildSketch() as ${2:sketchname}:",
                  "        {prefix}${3:class}(${4:params}, align=({prefix}Align.CENTER, {prefix}Align.CENTER))",
                  "        ${1:partname}.edges()",
                  "    $0"
                ]
              },
              "SketchLine": {
                "scope": "python",
                "prefix": "bd_skli",
                "body": [
                  "with {prefix}BuildSketch() as ${1:sketchname}:",
                  "    with {prefix}BuildLine() as ${2:linename}:",
                  "        {prefix}${3:class}(${4:params})",
                  "    make_face()",
                  "    $0"
                ]
              },
              "ExtrudeLine": {
                "scope": "python",
                "prefix": "bd_exli",
                "body": [
                  "with {prefix}BuildPart() as ${1:partname}:",
                  "    with {prefix}BuildSketch() as ${2:sketchname}:",
                  "        with {prefix}BuildLine() as ${3:linename}:",
                  "            {prefix}${4:class}(${5:params})",
                  "        {prefix}make_face()",
                  "    {prefix}extrude(amount=${6:amount})",
                  "    $0"
                ]
              },
              "ExtrudeSketch": {
                "scope": "python",
                "prefix": "bd_exsk",
                "body": [
                  "with {prefix}BuildPart() as ${1:partname}:",
                  "    with {prefix}BuildSketch() as ${2:sketchname}:",
                  "        {prefix}${3:class}(${4:params}, align=({prefix}Align.CENTER, {prefix}Align.CENTER))",
                  "    {prefix}extrude(amount=${5:amount})",
                  "    $0"
                ]
              }
            }
          },
          "order": 61
        },
        "OcpCadViewer.advanced.terminalDelay": {
          "type": "number",
          "default": 1000,
          "description": "%config.advanced.terminalDelay%",
          "order": 62
        },
        "OcpCadViewer.advanced.autostartDelay": {
          "type": "number",
          "default": 250,
          "description": "%config.advanced.autostartDelay%",
          "order": 63
        }
      }
    }
  },
  "scripts": {
